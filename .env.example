# ============================================================================
# STRETCH Group website — environment variables. EVERY variable is optional:
# with none set the site builds and runs (analytics no-op, contact messages
# are logged to the server console, all anti-spam extras are off). Copy to
# .env.local for local development; set production values in Vercel.
# ============================================================================

# --- Site ------------------------------------------------------------------
# Absolute production URL (no trailing slash) — canonicals, sitemap, OG
# images, JSON-LD @id (https://stretchgroup.be/#organization). Locales are
# path-prefixed on this one domain (/nl); see src/i18n/config.ts.
NEXT_PUBLIC_SITE_URL=https://stretchgroup.be

# --- Analytics (consent-gated by the cookie banner, Consent Mode v2) -------
# One domain → one ID each. Unset = the loader renders nothing.
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_CLARITY_ID=

# --- Contact-form delivery (first configured method wins) ------------------
# Priority: Microsoft Graph → webhook → SMTP → console log.
# Destination inbox for every submission (defaults to leads@stretchgroup.be):
LEAD_DESTINATION=leads@stretchgroup.be
# From-address for the notification (defaults to "STRETCH Group Website <website@stretchgroup.be>"):
LEAD_FROM_EMAIL=
# FASTEST PRODUCTION PATH: a Power Automate flow already delivers into
# leads@stretchgroup.be (the re-sound.be pattern) — paste its HTTP trigger
# URL here and the form is live. The POST body is
# { subject, body (html), text, isHtml, to, meta:{...fields}, spam? }.
LEAD_WEBHOOK_URL=
# Microsoft 365 (Graph, app-only Mail.Send) — setup notes in src/lib/msgraph-mail.ts:
MS_TENANT_ID=
MS_CLIENT_ID=
MS_CLIENT_SECRET=
MS_GRAPH_SENDER=
# Or plain SMTP (Nodemailer — optional dependency, loaded only when set):
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=
SMTP_FROM=

# --- Anti-spam ---------------------------------------------------------------
# Honeypot + spam scoring + disposable-email detection are always on. The
# two layers below switch on with their env var:
# HMAC secret for the signed time-to-submit form token. Any long random
# string (openssl rand -hex 32). Unset = tokens off (zero-config).
FORM_SIGNING_SECRET=
# Cloudflare Turnstile — ONE widget registered for stretchgroup.be,
# www.stretchgroup.be, the Vercel preview host and localhost. Unset = no
# CAPTCHA. Local always-pass test keys: sitekey 1x00000000000000000000AA /
# secret 1x0000000000000000000000000000000AA.
NEXT_PUBLIC_TURNSTILE_SITEKEY=
TURNSTILE_SECRET=
